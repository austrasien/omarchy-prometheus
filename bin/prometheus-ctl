#!/usr/bin/env python3
"""Tiny client: prometheus-ctl state | watch | call <channel> [json-or-string args...]"""
import json, os, socket, sys
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
from prometheus.server import socket_path

def arg(a):
    try:
        return json.loads(a)
    except ValueError:
        return a

def main():
    if len(sys.argv) < 2 or sys.argv[1] not in ("state", "watch", "call", "channels"):
        sys.exit(__doc__)
    s = socket.socket(socket.AF_UNIX)
    try:
        s.connect(str(os.environ.get("PROMETHEUS_SOCKET") or socket_path()))
    except OSError:
        sys.exit("prometheusd is not running")
    f = s.makefile("rwb")
    cmd = sys.argv[1]
    if cmd == "call":
        req = {"id": 1, "channel": sys.argv[2], "args": [arg(a) for a in sys.argv[3:]]}
    elif cmd in ("state", "channels"):
        req = {"id": 1, "channel": cmd}
    else:
        req = None
    if req:
        f.write((json.dumps(req) + "\n").encode()); f.flush()
    for line in f:
        msg = json.loads(line)
        if cmd == "watch":
            print(json.dumps(msg["state"], ensure_ascii=False), flush=True)
        elif msg.get("id") == 1:
            print(json.dumps(msg.get("data") if msg.get("ok") else msg, ensure_ascii=False, indent=2))
            break

main()
